<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Game-Inspired Creative Dump</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header class="site-header">
    <h1>My Creative Hub</h1>
    <nav>
      <a href="#notes">Notes</a>
      <a href="#gallery">Gallery</a>
      <a href="#about">About</a>
    </nav>
  </header>

  <main>
    <section id="notes">
      <h2>Notes</h2>
      <textarea id="noteInput" placeholder="Write something…"></textarea>
      <button id="saveBtn">Save Note</button>
      <ul id="noteList"></ul>
    </section>
  </main>

  <script src="script.js"></script>
</body>
</html>/* Reset default margin/padding */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Helvetica', sans-serif;
}

/* Fullscreen gradient background */
body {
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #6B73FF, #000DFF);
    color: white;
    text-align: center;
}

/* Centered container */
.container {
    max-width: 600px;
}

/* Big title */
h1 {
    font-size: 4rem;
    margin-bottom: 20px;
}

/* Description */
p {
    font-size: 1.2rem;
    margin-bottom: 40px;
}

/* Buttons */
.buttons {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.btn {
    text-decoration: none;
    color: white;
    background-color: rgba(0,0,0,0.2);
    padding: 15px 25px;
    border-radius: 10px;
    font-size: 1.2rem;
    transition: all 0.3s ease;
}

.btn:hover {
    background-color: rgba(255,255,255,0.2);
    transform: scale(1.05);
}



<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Game-Inspired Creative Dump</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header class="site-header">
    <h1>My Creative Hub</h1>
    <nav>
      <a href="#notes">Notes</a>
      <a href="#gallery">Gallery</a>
      <a href="#about">About</a>
    </nav>
  </header>

  <main>
    <section id="notes">
      <h2>Notes</h2>
      <textarea id="noteInput" placeholder="Write something…"></textarea>
      <button id="saveBtn">Save Note</button>
      <ul id="noteList"></ul>
    </section>
  </main>

  <script src="script.js"></script>
</body>
</html>


styles.css
/* Basic reset & fonts */
body {
  margin:0;
  padding:0;
  font-family: 'Arial', sans-serif;
  background: #111;
  color: #eee;
}

/* Header styling */
.site-header {
  background: #222;
  padding: 20px;
  text-align: center;
}
.site-header h1 {
  margin: 0;
  font-size: 2rem;
}
.site-header nav a {
  margin: 0 10px;
  color: #9cf;
  text-decoration: none;
}
.site-header nav a:hover {
  color: #fff;
}

/* Notes section styling */
#notes {
  padding: 20px;
}
#noteInput {
  width: 100%;
  height: 100px;
  background: #222;
  border: 1px solid #444;
  color: #eee;
  padding: 10px;
  box-sizing: border-box;
}
#saveBtn {
  margin-top:10px;
  padding: 10px 20px;
  background: #5a9;
  color: #111;
  border: none;
  cursor: pointer;
}
#noteList {
  list-style: none;
  padding: 0;
  margin-top: 20px;
}
#noteList li {
  background: #222;
  border: 1px solid #444;
  margin-bottom:10px;
  padding:10px;
}
// Grab elements
const noteInput = document.getElementById('noteInput');
const saveBtn = document.getElementById('saveBtn');
const noteList = document.getElementById('noteList');

// Load existing notes from localStorage
let notes = JSON.parse(localStorage.getItem('myNotes')) || [];

// Function to render notes list
function renderNotes() {
  noteList.innerHTML = '';
  notes.forEach((note, index) => {
    const li = document.createElement('li');
    li.textContent = note;
    // maybe add delete in future
    noteList.appendChild(li);
  });
}

// Save a new note
saveBtn.addEventListener('click', () => {
  const val = noteInput.value.trim();
  if (!val) return;
  notes.push(val);
  localStorage.setItem('myNotes', JSON.stringify(notes));
  noteInput.value = '';
  renderNotes();
});

// Initial render
renderNotes();

